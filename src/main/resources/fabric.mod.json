{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "name": "${mod_name}",
    "version": "${mod_version}",
    "description": "Adds in a load of customization to a few native UI elements such as the bossbar, scoreboard, etc.",
    "authors": [
        "Polyfrost"
    ],
    "contact": {
        "homepage": "https://polyfrost.org",
        "sources": "https://github.com/Polyfrost/VanillaHUD"
    },
    "license": "GPL-3.0",
    "environment": "client",
    "accessWidener": "vanillahud.classtweaker",
    "entrypoints": {
        "client": [
            {
                "value": "org.polyfrost.vanillahud.VanillaHUDClient",
                "adapter": "kotlin"
            }
        ]
    },
    "mixins": [
        "mixins.vanillahud.json"
    ],
    "depends": {
        "minecraft": "${minecraft_version_range}",
        "fabricloader": ">=${loader_version}",
        "fabric-api": "*",
        "oneconfigv1": ">=${oneconfig_version}"
    }
}
